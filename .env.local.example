# Copy this file to .env.local and fill in the values. Never commit .env.local.
# None of these may be used in browser code.

# Anthropic: console.anthropic.com > API keys
ANTHROPIC_API_KEY=

# Supabase: Project Settings > API Keys (use the "secret" key, sb_secret_...)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=

# Supabase: click "Connect" at the top of the project > Session pooler.
# Only used by `npm run db:setup` to create the tables.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
